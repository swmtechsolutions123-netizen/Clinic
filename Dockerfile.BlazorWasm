# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project files
COPY ["src/Clinic.BlazorWasm/Clinic.BlazorWasm.csproj", "src/Clinic.BlazorWasm/"]
COPY ["src/Clinic.Shared/Clinic.Shared.csproj", "src/Clinic.Shared/"]

# Restore dependencies
RUN dotnet restore "src/Clinic.BlazorWasm/Clinic.BlazorWasm.csproj"

# Copy source code
COPY . .

# Build the application
RUN dotnet build "src/Clinic.BlazorWasm/Clinic.BlazorWasm.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "src/Clinic.BlazorWasm/Clinic.BlazorWasm.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage - using nginx to serve static files
FROM nginx:alpine AS final
COPY --from=publish /app/publish/wwwroot /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
